rules_version = '2';

// FlowBoard is a real per-board membership model: a board is only
// readable/writable by users listed in its `memberIds` array, and a
// member with the 'viewer' role can read but not write tasks or board
// fields (except the owner, who can always change roles). The 4 seeded
// demo boards (`isDemo: true`) are the one exception — but only for
// guests (anonymous auth): they get a populated, live, editable board
// immediately with no invite needed, purely as a sandbox for
// visualization. A real account (Google or email) never sees the demo
// boards — it starts genuinely empty, same as any board created
// afterwards via "Create board", which is fully membership-gated for
// everyone. Identity integrity is enforced throughout too: you can only
// write your own profile/presence doc, and any task write must be
// attributed to the account that made it (no spoofing another user via
// the denormalized `updatedBy`/`author` fields the UI relies on for
// conflict banners and activity logs).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    function isAnonymousUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /meta/{docId} {
      allow read, write: if isSignedIn();
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSelf(uid);

      // Narrow exception: another signed-in user can drop a notification
      // into your subtree (e.g. "commented on your task"), but can't
      // read, edit, or delete anything here — only you can.
      match /notifications/{notifId} {
        allow read, update, delete: if isSignedIn() && isSelf(uid);
        allow create: if isSignedIn();
      }
    }

    match /boards/{boardId} {
      function isDemoBoard() {
        return resource.data.isDemo == true && isAnonymousUser();
      }
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }
      function isMemberOfNew() {
        return isSignedIn() && request.auth.uid in request.resource.data.memberIds;
      }
      function myRole() {
        return resource.data.roles[request.auth.uid];
      }
      function rolesUnchanged() {
        return request.resource.data.roles == resource.data.roles;
      }
      function isOwner() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }

      allow read: if isSignedIn() && (isDemoBoard() || isMember());
      allow create: if isSignedIn()
        && isMemberOfNew()
        && request.resource.data.ownerId == request.auth.uid;
      // Any non-viewer member can edit board fields (rename, recolor,
      // add a member, archive); only the owner can change `roles`. Demo
      // boards bypass membership entirely, same as their read rule.
      allow update: if isSignedIn()
        && (isDemoBoard() || (isMember() && myRole() != 'viewer' && (rolesUnchanged() || isOwner())));
      allow delete: if isOwner();

      match /presence/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isSelf(uid);
      }

      match /tasks/{taskId} {
        function board() {
          return get(/databases/$(database)/documents/boards/$(boardId)).data;
        }
        function isDemoTaskBoard() {
          return board().isDemo == true && isAnonymousUser();
        }
        function isBoardMember() {
          return isSignedIn() && request.auth.uid in board().memberIds;
        }
        function isBoardViewer() {
          return board().roles[request.auth.uid] == 'viewer';
        }

        allow read: if isSignedIn() && (isDemoTaskBoard() || isBoardMember());
        allow create, update: if isSignedIn()
          && (isDemoTaskBoard() || (isBoardMember() && !isBoardViewer()))
          && request.resource.data.updatedBy.id == request.auth.uid;
        allow delete: if isSignedIn() && (isDemoTaskBoard() || (isBoardMember() && !isBoardViewer()));
      }
    }
  }
}
